@model IEnumerable<EasyGames.Web.Models.Customer>
@{
    ViewData["Title"] = "Owner → Users";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="eg-h1 m-0">Users</h2>
    <a class="eg-btn" asp-action="Create">+ New</a>
</div>

@if (TempData["msg"] is string msg)
{
    <div class="eg-card mb-3">@msg</div>
}

<table class="table eg-table table-hover">
    <thead>
        <tr><th>Id</th><th>Name</th><th>Email</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Id</td>
                <td>@u.Name</td>
                <td>@u.Email</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@u.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@u.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

