﻿@using EasyGames.Web.Models
@{
    ViewData["Title"] = "Create User (Admin)";
}
<h2 class="eg-h1 mb-3">Create User</h2>
@if (TempData["toast"] is string t)
{
    <div class="eg-toast">@t</div>
}

<div class="eg-card p-3">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-2">
            <label>Name</label>
            <input name="name" class="form-control eg-input" />
        </div>

        <div class="mb-2">
            <label>Email</label>
            <input name="email" class="form-control eg-input" />
        </div>

        <div class="mb-2">
            <label>Password</label>
            <input name="password" type="password" class="form-control eg-input" />
        </div>

        <div class="mb-3">
            <label>Role</label>
            <select name="role" class="form-select eg-input">
                <option value="@AppRole.Customer">Customer</option>
                <option value="@AppRole.Shop">Shop</option>
                <option value="@AppRole.Owner">Owner</option>
            </select>
        </div>

        <button class="eg-btn" type="submit">Save</button>
        <a class="btn btn-link text-warning" asp-action="Index">Back</a>
    </form>
</div>
