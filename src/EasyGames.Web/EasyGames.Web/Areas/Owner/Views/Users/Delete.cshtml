@model EasyGames.Web.Models.AppUser
@{
    ViewData["Title"] = "Delete User";
}
<h2 class="eg-h1 mb-3">Delete User</h2>

<div class="eg-card p-3">
    <p>Are you sure you want to delete this user?</p>
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Role</dt>
        <dd class="col-sm-9">@Model.Role</dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <button class="eg-btn" type="submit">Delete</button>
        <a class="btn btn-link text-warning" asp-action="Index">Cancel</a>
    </form>
</div>