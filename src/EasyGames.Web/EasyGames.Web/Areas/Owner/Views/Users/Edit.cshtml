@model EasyGames.Web.Models.AppUser
@{
    ViewData["Title"] = "Edit User";
}
<h2 class="eg-h1 mb-3">Edit User</h2>

<div class="eg-card p-3">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="mb-2">
            <label>Name</label>
            <input asp-for="Name" class="form-control eg-input" />
        </div>

        <div class="mb-2">
            <label>Email</label>
            <input asp-for="Email" type="email" class="form-control eg-input" />
        </div>

        <div class="mb-2">
            <label>Phone</label>
            <input asp-for="Phone" type="tel" class="form-control eg-input" />
        </div>

        <div class="mb-2">
            <label>New Password (leave blank to keep current)</label>
            <input name="newPassword" type="password" class="form-control eg-input" />
        </div>

        <div class="mb-3">
            <label>Role</label>
            <select asp-for="Role" class="form-select eg-input">
                <option value="@EasyGames.Web.Models.AppRole.Customer">Customer</option>
                <option value="@EasyGames.Web.Models.AppRole.Shop">Shop</option>
                <option value="@EasyGames.Web.Models.AppRole.Owner">Owner</option>
            </select>
        </div>

        <button class="eg-btn" type="submit">Save</button>
        <a class="btn btn-link text-warning" asp-action="Index">Back</a>
    </form>
</div>