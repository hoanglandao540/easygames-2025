@model EasyGames.Web.Models.OwnerStock
@{
    ViewData["Title"] = "Edit Owner Stock";
    var products = (IEnumerable<EasyGames.Web.Models.Product>)ViewBag.Products;
}
<h2 class="eg-h1 mb-3">Edit Owner Stock</h2>
<div class="eg-card p-3">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label">Product <span class="text-warning">*</span></label>
            <select asp-for="ProductId" class="form-select eg-input" required>
                @foreach (var p in products)
                {
                    <option value="@p.Id">@p.Name (@p.Code) - $@p.Price.ToString("0.00")</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Quantity <span class="text-warning">*</span></label>
            <input asp-for="Qty" type="number" min="0" class="form-control eg-input" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Source <span class="text-warning">*</span></label>
            <input asp-for="Source" class="form-control eg-input" placeholder="e.g., Central Warehouse" required />
            <div class="form-text text-secondary">Required: Where did this stock come from?</div>
        </div>

        <div class="mb-3">
            <label class="form-label">Buy Price <span class="text-warning">*</span></label>
            <input asp-for="BuyPrice" type="number" step="0.01" min="0" class="form-control eg-input" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Sell Price <span class="text-warning">*</span></label>
            <input asp-for="SellPrice" type="number" step="0.01" min="0" class="form-control eg-input" required />
        </div>

        <div class="d-flex gap-2">
            <button class="eg-btn" type="submit">Save Changes</button>
            <a class="btn btn-outline-warning" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>