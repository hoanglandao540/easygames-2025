@model IEnumerable<EasyGames.Web.Areas.Owner.Controllers.ShopStocksController.ShopStockVM>
@{
    ViewData["Title"] = "Owner → Shop Stocks";
}
<h2 class="eg-h1 mb-3">Shop Stocks</h2>

@if (TempData["toast"] is string t)
{
    <div class="eg-card mb-3">@t</div>
}

<table class="table eg-table">
    <thead>
        <tr>
            <th>Shop</th>
            <th>Product</th>
            <th class="text-end">Qty</th>
            <th class="text-end">Reorder</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Shop</td>
                <td>@r.Product</td>
                <td class="text-end">@r.Qty</td>
                <td class="text-end">@r.Reorder</td>
            </tr>
        }
    </tbody>
</table>


