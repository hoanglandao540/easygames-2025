@model EasyGames.Web.ViewModels.CheckoutVM
@{
    ViewData["Title"] = "Checkout";
    var cart = (EasyGames.Web.ViewModels.CartVM)ViewBag.Cart;
    var userName = ViewBag.UserName as string ?? "";
    var userEmail = ViewBag.UserEmail as string ?? "";
}

<h2 class="eg-h1 mb-4">Checkout</h2>

@if (!cart.Rows.Any())
{
    <div class="eg-card p-4 text-center">
        <h5 class="mb-3">Your cart is empty</h5>
        <p class="text-secondary mb-3">Add items to your cart before checkout</p>
        <a class="eg-btn" asp-area="Storefront" asp-controller="Catalog" asp-action="Index">
            Browse Catalog
        </a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="eg-card p-4">
                <h5 class="mb-4">Billing & Delivery Information</h5>
                <form method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="text"
                               class="form-control eg-input"
                               value="@userName"
                               readonly
                               style="background-color: #1a2030; cursor: not-allowed;" />
                        <div class="form-text text-secondary">From your account (cannot be changed)</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email Address</label>
                        <input type="email"
                               class="form-control eg-input"
                               value="@userEmail"
                               readonly
                               style="background-color: #1a2030; cursor: not-allowed;" />
                        <div class="form-text text-secondary">Receipt will be sent here (from your account)</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Delivery Address <span class="text-warning">*</span></label>
                        <textarea name="address"
                              rows="3"
                              class="form-control eg-input"
                              placeholder="Enter your complete delivery address"
                              required></textarea>
                        <div class="form-text text-secondary">Street address, city, postal code</div>
                    </div>

                    @* Use ViewData.ModelState in views (ModelState is not directly in scope) *@
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-warning mb-3">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    }

                    <div class="d-grid gap-2">
                        <button class="eg-btn" type="submit">
                            Complete Purchase - $@cart.GrandTotal.ToString("0.00")
                        </button>
                        <a class="btn btn-outline-warning" asp-area="Storefront" asp-controller="Cart" asp-action="Index">
                            Back to Cart
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="eg-card p-4">
                <h5 class="mb-4">Order Summary</h5>

                <div class="mb-4">
                    <table class="table mb-0">
                        <thead class="border-bottom border-secondary">
                            <tr>
                                <th class="border-0 text-light">Item</th>
                                <th class="border-0 text-light text-end">Qty</th>
                                <th class="border-0 text-light text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in cart.Rows)
                            {
                                <tr class="border-bottom border-secondary">
                                    <td class="border-0 text-light py-3">
                                        <div class="fw-bold">@r.Name</div>
                                        <div class="small text-secondary">$@r.Price.ToString("0.00") each</div>
                                    </td>
                                    <td class="border-0 text-light text-end py-3">×@r.Qty</td>
                                    <td class="border-0 text-light text-end py-3">$@r.LineTotal.ToString("0.00")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="border-top border-warning pt-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Subtotal:</span>
                        <span class="text-light">$@cart.GrandTotal.ToString("0.00")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Tax:</span>
                        <span class="text-light">Calculated at confirmation</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-secondary">Shipping:</span>
                        <span class="text-light">Free</span>
                    </div>
                    <div class="d-flex justify-content-between border-top border-warning pt-3">
                        <span class="fw-bold fs-5">Total:</span>
                        <span class="fw-bold fs-4 text-warning">${@cart.GrandTotal.ToString("0.00")}</span>
                    </div>
                </div>

                <div class="mt-4 p-3" style="background: rgba(212, 178, 93, 0.1); border-radius: 8px;">
                    <div class="small text-secondary">
                        <strong class="text-warning">🔒 Secure Checkout</strong><br />
                        Your payment information is encrypted and secure. We accept all major payment methods.
                    </div>
                </div>
            </div>
        </div>
    </div>
}
