@model EasyGames.Web.Models.Order
@{
    ViewData["Title"] = $"Order #{Model.Id}";
}

<div class="mb-3">
    <a class="btn btn-link text-warning" asp-action="Index">← Back to Orders</a>
</div>

<h2 class="eg-h1 mb-3">Order #@Model.Id</h2>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="eg-card p-3">
            <h5 class="mb-3">Order Details</h5>
            <table class="table eg-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th class="text-end">Price</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>@line.Name</td>
                            <td class="text-end">$@line.Price.ToString("0.00")</td>
                            <td class="text-center">@line.Qty</td>
                            <td class="text-end">$@((line.Price * line.Qty).ToString("0.00"))</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3" class="text-end">Total</th>
                        <th class="text-end">$@Model.Total.ToString("0.00")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="eg-card p-3">
            <h5 class="mb-3">Order Info</h5>
            <dl class="row mb-0">
                <dt class="col-5">Order Date:</dt>
                <dd class="col-7">@Model.CreatedUtc.ToString("MMM dd, yyyy h:mm tt")</dd>

                <dt class="col-5">Shop:</dt>
                <dd class="col-7">@(Model.Shop?.City ?? "Online") @(Model.Shop?.ShopCode ?? "")</dd>

                <dt class="col-5">Phone:</dt>
                <dd class="col-7">@(Model.CustomerPhone ?? "N/A")</dd>

                <dt class="col-5">Status:</dt>
                <dd class="col-7"><span class="badge bg-success">Completed</span></dd>
            </dl>
        </div>
    </div>
</div>