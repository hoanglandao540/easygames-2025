@model EasyGames.Web.ViewModels.CartVM
@{
    ViewData["Title"] = "Cart";
    var backToCart = Context.Request.Path + Context.Request.QueryString; // pass as returnUrl
}
<h2 class="eg-h1 mb-3">Cart</h2>

@if (!Model.Rows.Any())
{
    <div class="eg-card">Your cart is empty.</div>
}
else
{
    <table class="table eg-table table-hover">
        <thead>
            <tr>
                <th>Product</th>
                <th class="text-end">Price</th>
                <th class="text-center">Qty</th>
                <th class="text-end">Line Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td>@r.Name</td>
                    <td class="text-end">@r.Price.ToString("0.00")</td>
                    <td class="text-center">
                        <a class="eg-btn eg-qty-btn"
                           asp-area="Storefront" asp-controller="Cart" asp-action="Dec"
                           asp-route-id="@r.ProductId"
                           asp-route-returnUrl="@backToCart">
                            &minus;
                        </a>
                        <span class="mx-2">@r.Qty</span>
                        <a class="eg-btn eg-qty-btn"
                           asp-area="Storefront" asp-controller="Cart" asp-action="Inc"
                           asp-route-id="@r.ProductId"
                           asp-route-returnUrl="@backToCart">
                            +
                        </a>
                    </td>
                    <td class="text-end">@r.LineTotal.ToString("0.00")</td>
                    <td class="text-end">
                        <a asp-area="Storefront" asp-controller="Cart" asp-action="Remove"
                           asp-route-id="@r.ProductId" asp-route-returnUrl="@backToCart">
                            Remove
                        </a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Grand Total</th>
                <th class="text-end">@Model.GrandTotal.ToString("0.00")</th>
                <th></th>
            </tr>
        </tfoot>
    </table>

    <div class="d-flex gap-2">
        <a class="eg-btn" asp-area="Storefront" asp-controller="Checkout" asp-action="Index">Checkout</a>
        <a class="eg-btn eg-btn-sm"
           asp-area="Storefront" asp-controller="Cart" asp-action="Clear"
           asp-route-returnUrl="@backToCart">Clear Cart</a>
    </div>
}
