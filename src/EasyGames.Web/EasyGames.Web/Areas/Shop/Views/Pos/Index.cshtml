}

<h2 class="eg-h1 mb-3">Point of Sale</h2>

@if (TempData["toast"] is string toast)
{
    <div class="eg-card p-3 mb-3">@toast</div>
}

<div class="row g-4">
    <!-- LEFT: add line + customer info + pay -->
    <div class="col-lg-5">
        <div class="eg-card p-3 mb-3">
            <h5 class="mb-3">1) Choose Shop</h5>
            <!-- This select will be submitted with Pay -->
            <select id="shopId" class="form-select eg-input">
                @foreach (var s in shops)
                {
                    <option value="@s.Id">@s.City (@s.ShopCode)</option>
                }
            </select>
        </div>

        <div class="eg-card p-3 mb-3">
            <h5 class="mb-3">2) Add Product</h5>
            <form asp-area="Shop" asp-controller="Pos" asp-action="AddLine" method="post" class="row g-2">
                @Html.AntiForgeryToken()
                <div class="col-8">
                    <select name="productId" class="form-select eg-input">
                        @foreach (var p in products)
                        {
                            <option value="@p.Id">@p.Name (@p.Price.ToString("0.00"))</option>
                        }
                    </select>
                </div>
                <div class="col-4 d-flex gap-2">
                    <input name="qty" type="number" min="1" value="1" class="form-control eg-input text-end" />
                    <button class="eg-btn" type="submit">Add</button>
                </div>
            </form>
            <div class="form-text mt-2">Tip: add multiple products, then set customer details and Pay.</div>
        </div>

        <div class="eg-card p-3">
            <h5 class="mb-3">3) Customer (for receipt & tier)</h5>
            <!-- This form only submits on Pay -->
            <form id="payForm" asp-area="Shop" asp-controller="Pos" asp-action="Pay" method="post">
                @Html.AntiForgeryToken()
                <!-- shopId gets copied from the picker on Pay click -->
                <input type="hidden" name="shopId" id="payShopId" value="" />

                <div class="mb-2">
                    <label class="form-label">Customer Name</label>
                    <input name="customerName" class="form-control eg-input" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Customer Email</label>
                    <input name="customerEmail" type="email" class="form-control eg-input" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Customer Phone</label>
                    <input name="customerPhone" class="form-control eg-input" />
                    <div class="form-text">Used to find repeat customers and apply tier discounts.</div>
                </div>

                <button class="eg-btn w-100 mt-2" type="submit" id="payBtn">Pay</button>
            </form>
        </div>
    </div>

    <!-- RIGHT: cart -->
    <div class="col-lg-7">
        <div class="eg-card p-3">
            <div class="d-flex align-items-center mb-2">
                <h5 class="mb-0">Cart</h5>
                <div class="ms-auto">
                    <a class="eg-btn eg-btn-sm" asp-area="Shop" asp-controller="Pos" asp-action="Clear">Clear</a>
                </div>
            </div>

            @if (Model == null || Model.Rows.Count == 0)
            {
                <div class="text-secondary">No items yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table eg-table align-middle">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th class="text-end">Price</th>
                                <th class="text-center" style="width:220px;">Qty</th>
                                <th class="text-end">Line Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Rows)
                            {
                                <tr>
                                    <td>@r.Name</td>
                                    <td class="text-end">@r.Price.ToString("0.00")</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <!-- NOTE: PosCartRowVM uses ProductId, not Id -->
                                            <a class="btn btn-sm eg-btn eg-qty-btn"
                                               asp-area="Shop" asp-controller="Pos" asp-action="Dec"
                                               asp-route-id="@r.ProductId">−</a>
                                            <span class="px-3">@r.Qty</span>
                                            <a class="btn btn-sm eg-btn eg-qty-btn"
                                               asp-area="Shop" asp-controller="Pos" asp-action="Inc"
                                               asp-route-id="@r.ProductId">+</a>
                                        </div>
                                    </td>
                                    <td class="text-end">@((r.Price * r.Qty).ToString("0.00"))</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-warning"
                                           asp-area="Shop" asp-controller="Pos" asp-action="Remove"
                                           asp-route-id="@r.ProductId">Remove</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Subtotal</th>
                                <th class="text-end">@Model.GrandTotal.ToString("0.00")</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // copy selected shopId into the Pay form right before submit
        (function () {
            const payBtn = document.getElementById('payBtn');
            const payShopId = document.getElementById('payShopId');
            const shopPick = document.getElementById('shopId');
            if (payBtn && payShopId && shopPick) {
                payBtn.addEventListener('click', function () {
                    payShopId.value = shopPick.value || "";
                });
            }
        })();
    </script>
}
