@model int
@{
    ViewData["Title"] = "POS Success";
    var tier = (EasyGames.Web.Services.TierLevel)ViewBag.Tier;
}
<div class="eg-card">
    <h3 class="eg-h1 mb-2">Payment successful</h3>
    <p>Order <b>#@Model</b> saved. Customer tier: <b>@tier</b>.</p>
    <a class="eg-btn" asp-action="Index">Start New Sale</a>
</div>
