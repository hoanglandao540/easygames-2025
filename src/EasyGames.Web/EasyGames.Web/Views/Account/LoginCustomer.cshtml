@{
    ViewData["Title"] = "Customer Login";
    var returnUrl = (string?)ViewBag.ReturnUrl;
}
<h2 class="eg-h1 mb-3">Customer Login</h2>

@if (TempData["toast"] is string t)
{
    <div class="eg-toast mb-3">@t</div>
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="eg-card p-4">
            <form asp-action="LoginCustomer" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input name="email" type="email" class="form-control eg-input" placeholder="your@email.com" required />
                </div>

                <div class="mb-4">
                    <label class="form-label">Password</label>
                    <input name="password" type="password" class="form-control eg-input" placeholder="••••••••" required />
                </div>

                <div class="d-grid gap-2">
                    <button class="eg-btn" type="submit">Login</button>
                    <div class="text-center mt-3">
                        <span class="text-secondary">Don't have an account?</span>
                        <a class="text-warning ms-2" asp-area="" asp-controller="Account" asp-action="Register">
                            Create Account
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>