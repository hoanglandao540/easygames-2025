@{
    ViewData["Title"] = "Register";
}
<h2 class="eg-h1 mb-3">Register</h2>
@if (TempData["toast"] is string t)
{
    <div class="eg-toast">@t</div>
}

<div class="eg-card p-3">
    <form asp-action="Register" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-2">
            <label>Name</label>
            <input name="name" class="form-control eg-input" />
        </div>

        <div class="mb-2">
            <label>Email</label>
            <input name="email" class="form-control eg-input" />
        </div>

        <div class="mb-3">
            <label>Password</label>
            <input name="password" type="password" class="form-control eg-input" />
        </div>

        <button class="eg-btn" type="submit">Create Account</button>
        <p class="eg-note mt-2">By signing up you create a <strong>Customer</strong> account.</p>
    </form>
</div>



