@{
    ViewData["Title"] = "Welcome (Guest)";
}
<section class="container py-5">
    <div class="text-center mb-4">
        <h1 class="eg-h1">Welcome to EasyGames</h1>
        <p class="lead">We’re your friendly shop for <strong>Games</strong>, <strong>Toys</strong>, and <strong>Books</strong>. Browse as a guest or sign in to shop.</p>
    </div>

    <!-- Role overview cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-3">
            <div class="eg-card p-4 h-100">
                <h4 class="mb-2">Owner (Admin)</h4>
                <p class="mb-3">Manages products, shops, stock, and users. Sends updates to customers.</p>
                <a class="eg-btn eg-btn-sm" asp-controller="Account" asp-action="Login">Admin Login</a>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="eg-card p-4 h-100">
                <h4 class="mb-2">Shop Proprietor</h4>
                <p class="mb-3">Runs the store: sells via POS and keeps stock healthy.</p>
                <a class="eg-btn eg-btn-sm" asp-controller="Account" asp-action="Login">Shop Login</a>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="eg-card p-4 h-100">
                <h4 class="mb-2">Customer</h4>
                <p class="mb-3">Browse, add to cart, and checkout. Track your orders and rewards.</p>
                <div class="d-flex gap-2">
                    <a class="eg-btn eg-btn-sm" asp-controller="Account" asp-action="Login">Customer Login</a>
                    <a class="eg-btn eg-btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="eg-card p-4 h-100">
                <h4 class="mb-2">Guest Mode</h4>
                <p class="mb-3">Just looking? Continue as guest to explore what we sell.</p>
                <a class="eg-btn eg-btn-sm" asp-area="Storefront" asp-controller="Catalog" asp-action="Index">Browse Catalog</a>
            </div>
        </div>
    </div>

    <!-- Our Departments: Games · Toys · Books -->
    <div class="mb-3">
        <h3 class="eg-h1">Our Departments</h3>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-4">
            <div class="eg-card p-4 h-100">
                <h5 class="mb-2">Games</h5>
                <ul class="mb-0">
                    <li>Console & PC titles for all ages</li>
                    <li>Family/co-op and competitive picks</li>
                    <li>Pre-orders & seasonal favourites</li>
                </ul>
                <div class="mt-3">
                    <a class="eg-btn eg-btn-sm" asp-area="Storefront" asp-controller="Catalog" asp-action="Index">See Games</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="eg-card p-4 h-100">
                <h5 class="mb-2">Toys</h5>
                <ul class="mb-0">
                    <li>STEM kits & puzzles</li>
                    <li>Outdoor toys & family fun</li>
                    <li>Collectibles & gifts</li>
                </ul>
                <div class="mt-3">
                    <a class="eg-btn eg-btn-sm" asp-area="Storefront" asp-controller="Catalog" asp-action="Index">See Toys</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="eg-card p-4 h-100">
                <h5 class="mb-2">Books</h5>
                <ul class="mb-0">
                    <li>Children’s stories & YA</li>
                    <li>Graphic novels & art books</li>
                    <li>Study guides & activity books</li>
                </ul>
                <div class="mt-3">
                    <a class="eg-btn eg-btn-sm" asp-area="Storefront" asp-controller="Catalog" asp-action="Index">See Books</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Services (not website tech; real shop services) -->
    <div class="mb-3">
        <h3 class="eg-h1">Store Services</h3>
    </div>
    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <div class="eg-card p-4 h-100">
                <h5 class="mb-2">Click & Collect</h5>
                <p class="mb-0">Reserve online and pick up at the shop.</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="eg-card p-4 h-100">
                <h5 class="mb-2">Rare Collection</h5>
                <p class="mb-0">Find Rare and unique things at the shop</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="eg-card p-4 h-100">
                <h5 class="mb-2">Gift Wrap</h5>
                <p class="mb-0">Optional gift wrapping at checkout.</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="eg-card p-4 h-100">
                <h5 class="mb-2">Easy Returns</h5>
                <p class="mb-0">7-day simple exchange on unopened items.</p>
            </div>
        </div>
    </div>
</section>


