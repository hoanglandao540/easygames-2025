@{
    var title = ViewData["Title"] as string ?? "EasyGames";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - EasyGames</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Head", required: false)
</head>
<body class="eg-bg text-light">
    <header class="eg-surface border-bottom eg-border shadow-sm">
        <div class="container py-3 d-flex align-items-center justify-content-between">
            <a class="navbar-brand text-warning fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                EasyGames
            </a>
            <nav class="d-flex gap-3">
                <a class="eg-nav" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                <a class="eg-nav" asp-area="Owner" asp-controller="Products" asp-action="Index">Owner → Products</a>
                <a class="eg-nav" asp-area="Owner" asp-controller="Users" asp-action="Index">Owner → Users</a>
                <a class="eg-nav" asp-area="Owner" asp-controller="Shops" asp-action="Index">Owner → Shops</a>
            </nav>
        </div>
    </header>

    <main class="container my-4">
        @RenderBody()
    </main>

    <footer class="eg-surface border-top eg-border">
        <div class="container py-3 text-secondary small">
            Midnight+Gold • © @(DateTime.UtcNow.Year) EasyGames
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
