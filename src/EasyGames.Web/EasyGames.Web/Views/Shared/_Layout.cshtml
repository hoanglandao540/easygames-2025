@using System.Security.Claims
@{
    var title = ViewData["Title"] as string ?? "EasyGames";

    var isAuth = User?.Identity?.IsAuthenticated ?? false;
    var roleClaim = User?.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var userName = User?.Identity?.Name ?? "";

    var isOwner = isAuth && string.Equals(roleClaim, "Owner", StringComparison.OrdinalIgnoreCase);
    var isShop = isAuth && string.Equals(roleClaim, "Shop", StringComparison.OrdinalIgnoreCase);
    var isCustomer = isAuth && string.Equals(roleClaim, "Customer", StringComparison.OrdinalIgnoreCase);
}
